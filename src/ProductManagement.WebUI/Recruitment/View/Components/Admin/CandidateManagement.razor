            "Are you sure you want to deactivate this candidate? This will hide them from active searches but data will be retained.");

        if (!confirmed)
            return;

        try
        {
            errorMessage = string.Empty;

            var response = await Http.PatchAsync($"api/CandidateSearch/deactivate/{userId}", null);

            if (response.IsSuccessStatusCode)
