@page "/admin/candidate-management"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Domain.DTO
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Candidate Management</PageTitle>
<div class="container-fluid mt-4">
    <h2 class="kpmg-header">
        <div class="kpmg-title">Candidate Management</div>
    </h2>

    <div class="form-container cts-width mb-3">
        <div class="form-content nav-bg px-3">
            <EditForm Model="@currentProgram" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-4 custom-input text-end">
                        <label class="form-label">Recruitment Program Name</label>
                    </div>
                    <div class="col-md-8 mt-2">
                        <InputText @bind-Value="currentProgram.Name" class="cts-width-100 custom-input" />
                        <ValidationMessage For="@(() => currentProgram.Name)" />
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-1 align-items-center">
                    <div class="col-md-4 custom-input text-end">
                        <label class="form-label">Open Date</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputDate @bind-Value="currentProgram.OpenDate" class="custom-input " />
                        <ValidationMessage For="@(() => currentProgram.OpenDate)" />
                    </div>

                    <div class="col-md-2 custom-input text-end">
                        <label class="form-label">Close Date</label>
                    </div>
                    <div class="col-md-3 mt-2 text-end">
                        <InputDate @bind-Value="currentProgram.CloseDate" class="custom-input " />
                        <ValidationMessage For="@(() => currentProgram.CloseDate)" />
                        @if (currentProgram.CloseDate < currentProgram.OpenDate && currentProgram.CloseDate != default && currentProgram.OpenDate != default)
                        {
                            <span class="validation-message">Close date must be after open date</span>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-1">
                    <div class="col-md-4"></div>
                    <div class="col-md-8 mt-1">
                        <button type="submit" class="add-btn custom-btn1 me-2" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(isEditMode ? "Update" : "Add")
                        </button>
                        @if (isEditMode)
                        {
                            <button type="button" class="custom-btn1" @onclick="CancelEdit" disabled="@isLoading">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="universities-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Recruitment Program Name</th>
                    <th>Open Date</th>
                    <th>Close Date</th>
                    <th>Updated On</th>
                    <th>Total Submitted Applications</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoadingTable)
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Loading...
                        </td>
                    </tr>
                }
                else if (recruitmentPrograms == null || !recruitmentPrograms.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center">No recruitment programs found</td>
                    </tr>
                }
                else
                {
                    @foreach (var program in recruitmentPrograms)
                    {
                        <tr>
                            <td>@program.Name</td>
                            <td>@program.OpenDate?.ToString("dd/MM/yyyy")</td>
                            <td>@program.CloseDate?.ToString("dd/MM/yyyy")</td>
                            <td>@program.UpdatedOn.ToString("MMM dd, yyyy HH:mm:ss")</td>
                            <td>@program.TotalSubmitted</td>
                            <td>
                                <button class="btn btn-link p-0" @onclick="() => EditProgram(program)" disabled="@isLoading">
                                    <img src="/images/icons8-edit-property-30.png" class="cst-icon-action"
                                         alt="Edit" />
                                </button>
                            </td>
                            <td>
                                <button class="btn btn-link p-0" @onclick="() => DeleteProgram(program.Id)" disabled="@isLoading">
                                    <img src="/images/delete.png" class="cst-icon-action"
                                         alt="Edit" />
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="form-container cts-width mb-3 mt-5">
        <div class="form-content nav-bg px-3 py-3">
            <EditForm Model="@searchFilter" OnValidSubmit="@HandleSearch">
                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">Candidate Name</label>
                    </div>
                    <div class="col-md-9 mt-2">
                        <InputText @bind-Value="searchFilter.Name" class="cts-width-100 custom-input" placeholder="Enter candidate name" />
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">Candidate Email</label>
                    </div>
                    <div class="col-md-9 mt-2">
                        <InputText @bind-Value="searchFilter.Email" class="cts-width-100 custom-input" placeholder="Enter email" />
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">University</label>
                    </div>
                    <div class="col-md-9 mt-2">
                        <InputText @bind-Value="searchFilter.University" class="cts-width-100 custom-input" placeholder="Enter university" />
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">Major</label>
                    </div>
                    <div class="col-md-9 mt-2">
                        <InputText @bind-Value="searchFilter.Major" class="cts-width-100 custom-input" placeholder="Enter major" />
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">From Date</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputDate @bind-Value="searchFilter.FromDate" class="custom-input cts-width-100" />
                    </div>

                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">To Date</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputDate @bind-Value="searchFilter.ToDate" class="custom-input cts-width-100" />
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">Office</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputSelect @bind-Value="searchFilter.Office" class="custom-input cts-width-100">
                            <option value="">All</option>
                            @foreach (var office in officeOptions)
                            {
                                <option value="@office.Code">@office.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">Status</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputSelect @bind-Value="searchFilter.Status" class="custom-input cts-width-100">
                            <option value="Active">Active (Default)</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Exported">Exported</option>
                            <option value="Pending">Pending</option>
                            <option value="Rejected">Rejected</option>
                        </InputSelect>
                        @if (!string.IsNullOrEmpty(searchFilter.Status))
                        {
                            <small class="text-muted d-block mt-1">Selected: @searchFilter.Status</small>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">Gender</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputSelect @bind-Value="searchFilter.Gender" class="custom-input cts-width-100">
                            <option value="">All</option>
                            @foreach (var gender in genderOptions)
                            {
                                <option value="@gender.Code">@gender.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">1<sup>st</sup> preference</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputSelect @bind-Value="searchFilter.FirstPreference" class="custom-input cts-width-100">
                            <option value="">All</option>
                            @foreach (var pref in preferenceOptions)
                            {
                                <option value="@pref.Code">@pref.DisplayName</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">2<sup>nd</sup> preference</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputSelect @bind-Value="searchFilter.SecondPreference" class="custom-input cts-width-100">
                            <option value="">All</option>
                            @foreach (var pref in preferenceOptions)
                            {
                                <option value="@pref.Code">@pref.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3 custom-input text-end">
                        <label class="form-label">Recruitment program</label>
                    </div>
                    <div class="col-md-3 mt-2">
                        <InputSelect @bind-Value="searchFilter.ProgramId" class="custom-input cts-width-100">
                            <option value="0">All</option>
                            @foreach (var program in recruitmentPrograms)
                            {
                                <option value="@program.Id">@program.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="d-flex justify-content-evenly mb-1">
                    <div class="col-md-3"></div>
                    <div class="col-md-9 mt-1">
                        <button type="submit" class="add-btn custom-btn1 me-2" disabled="@isSearching">
                            @if (isSearching)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Search
                        </button>
                        <button type="button" class="add-btn custom-btn1 me-2" @onclick="ExportToExcel" disabled="@isExporting">
                            @if (isExporting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Export To Excel
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @if (hasSearched)
    {
        <div class="universities-table mt-4">
            <table class="table table-bordered">
                <thead>
                    <tr style="background-color: #a6a4ff;">
                        <th>Name</th>
                        <th>DOB</th>
                        <th>Gender</th>
                        <th>Status</th>
                        <th>Office</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>IDCardNo</th>
                        <th>University</th>
                        <th>Major</th>
                        <th>GPA</th>
                        <th>SubmittedOn</th>
                        <th>Details</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody class="fs-9">
                    @if (isSearching)
                    {
                        <tr>
                            <td colspan="14" class="text-center">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Searching...
                            </td>
                        </tr>
                    }
                    else if (candidates == null || !candidates.Any())
                    {
                        <tr>
                            <td colspan="14" class="text-center">No candidates found</td>
                        </tr>
                    }
                    else
                    {
                        var groupedCandidates = candidates
                        .GroupBy(c => c.UserId)
                        .Select(g => new
                        {
                            UserId = g.Key,
                            First = g.First(),
                            SubmittedGroups = g
                        .GroupBy(x => x.SubmittedOn.Date)
                        .OrderByDescending(x => x.Key)
                        .Select(sg => new
                        {
                            SubmittedOn = sg.Key,
                            Items = sg
                        .OrderByDescending(x => x.GPA)
                        .ToList()
                        })
                        .ToList()
                        })
                        .ToList();
                        @foreach (var userGroup in groupedCandidates)
                        {
                            var person = userGroup.First;
                            int totalRows = userGroup.SubmittedGroups.Sum(sg => sg.Items.Count);
                            bool renderedPerson = false;
                            foreach (var submittedGroup in userGroup.SubmittedGroups)
                            {
                                int submittedRowCount = submittedGroup.Items.Count;
                                bool renderedSubmittedOn = false;
                                for (int i = 0; i < submittedGroup.Items.Count; i++)
                                {
                                    var candidate = submittedGroup.Items[i];
                                    <tr>
                                        @if (!renderedPerson)
                                        {
                                            <td rowspan="@totalRows">@person.FullName</td>
                                            <td rowspan="@totalRows">@person.DateOfBirth?.ToString("MMM dd, yyyy")</td>
                                            <td rowspan="@totalRows">@person.Gender</td>
                                            <td rowspan="@totalRows">@person.Status</td>
                                            <td rowspan="@totalRows">@person.Office</td>
                                            <td rowspan="@totalRows">@person.Mobile</td>
                                            <td rowspan="@totalRows">@person.Email</td>
                                            <td rowspan="@totalRows">
                                                @(string.IsNullOrEmpty(person.IDCardNo) ? "N/A" : person.IDCardNo)
                                            </td>
                                        }
                                        <td>@candidate.University</td>
                                        <td>@candidate.Major</td>
                                        <td>@candidate.GPA</td>
                                        @if (!renderedSubmittedOn)
                                        {
                                            <td rowspan="@submittedRowCount">
                                                @submittedGroup.SubmittedOn.ToString("MMM dd, yyyy")
                                            </td>
                                        }
                                        @if (!renderedPerson)
                                        {
                                            <td rowspan="@totalRows">
                                                <a href="#" @onclick="() => ViewDetails(person.UserId)"
                                                   @onclick:preventDefault class="btn-link">
                                                    Details...
                                                </a>
                                            </td>
                                            <td rowspan="@totalRows">
                                                @if (person.Status == "Active")
                                                {
                                                    <button class="btn btn-sm" 
                                                            @onclick="() => DeactivateCandidate(person.UserId)"
                                                            title="Deactivate">
                                                        <img src="/images/delete.png" class="cst-icon-action" alt="Delete" />
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm" 
                                                            @onclick="() => ActivateCandidate(person.UserId)"
                                                            title="Activate">
                                                        <img src="/images/16x16-icon-45589.png" class="cst-icon-action" alt="Delete" />
                                                    </button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                    renderedPerson = true;
                                    renderedSubmittedOn = true;
                                }
                            }
                        }
                    }
                </tbody>
            </table>
            @if (candidates != null && candidates.Any())
            {
                <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                    <div>
                        <button class="btn custom-btn1 btn-sm" @onclick="PreviousPage" disabled="@(currentPage <= 1)">
                            Previous
                        </button>
                        <span class="mx-3">Page @currentPage of @totalPages</span>
                        <button class="btn custom-btn1 btn-sm" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                            Next
                        </button>
                    </div>
                    <div>
                        Total: @totalCandidates candidates
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3">
            @successMessage
        </div>
    }
      @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }
</div>

@code {
    private List<RecruitmentProgramDTO> recruitmentPrograms = new();
    private CreateRecruitmentProgramDTO currentProgram = new();
    private int editingProgramId = 0;
    private bool isEditMode = false;
    private bool isLoading = false;
    private bool isLoadingTable = false;

    private CandidateSearchFilter searchFilter = new() { Status = "Active" };
    private List<CandidateSearchResult> candidates = new();
    private bool isSearching = false;
    private bool isExporting = false;
    private bool hasSearched = false;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalCandidates = 0;

    private List<SystemConfigurationDTO> officeOptions = new();
    private List<SystemConfigurationDTO> genderOptions = new();
    private List<SystemConfigurationDTO> preferenceOptions = new();

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private HttpClient Http => ClientFactory.CreateClient("LocalAPI");

    protected override async Task OnInitializedAsync()
    {
        await LoadPrograms();
        await LoadSystemConfigurations();
    }
    private async Task LoadSystemConfigurations()
    {
        try
        {
            var officeResponse = await Http.GetFromJsonAsync<List<SystemConfigurationDTO>>(
                "api/SystemConfiguration/type/Office/active");
            officeOptions = officeResponse ?? new();

            var genderResponse = await Http.GetFromJsonAsync<List<SystemConfigurationDTO>>(
                "api/SystemConfiguration/type/Gender/active");
            genderOptions = genderResponse ?? new();

            var preferenceResponse = await Http.GetFromJsonAsync<List<SystemConfigurationDTO>>(
                "api/SystemConfiguration/type/FirstPreference/active");
            preferenceOptions = preferenceResponse ?? new();

            Console.WriteLine($"Loaded {officeOptions.Count} offices, {genderOptions.Count} genders, {preferenceOptions.Count} preferences");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading system configurations: {ex.Message}");
            officeOptions = new();
            genderOptions = new();
            preferenceOptions = new();
        }
    }
    private async Task LoadPrograms()
    {
        try
        {
            isLoadingTable = true;
            errorMessage = string.Empty;

            var response = await Http.GetAsync("api/RecruitmentProgram");

            if (response.IsSuccessStatusCode)
            {
                recruitmentPrograms = await response.Content.ReadFromJsonAsync<List<RecruitmentProgramDTO>>() ?? new();
            }
            else
            {
                errorMessage = "Failed to load recruitment programs";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingTable = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (currentProgram.CloseDate < currentProgram.OpenDate)
        {
            errorMessage = "Close date must be after open date";
            return;
        }

        if (isEditMode)
        {
            await UpdateProgram();
        }
        else
        {
            await AddProgram();
        }
    }

    private async Task AddProgram()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var createDTO = new CreateRecruitmentProgramDTO
            {
                Name = currentProgram.Name,
                OpenDate = currentProgram.OpenDate,
                CloseDate = currentProgram.CloseDate
            };

            var response = await Http.PostAsJsonAsync("api/RecruitmentProgram", createDTO);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Recruitment program added successfully!";
                await LoadPrograms();
                ResetForm();

                await Task.Delay(3000);
                successMessage = string.Empty;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to add recruitment program: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateProgram()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var updateDTO = new UpdateRecruitmentProgramDTO
            {
                Id = editingProgramId,
                Name = currentProgram.Name,
                OpenDate = currentProgram.OpenDate,
                CloseDate = currentProgram.CloseDate
            };

            var response = await Http.PutAsJsonAsync("api/RecruitmentProgram", updateDTO);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Recruitment program updated successfully!";
                await LoadPrograms();
                ResetForm();

                await Task.Delay(3000);
                successMessage = string.Empty;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to update recruitment program: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditProgram(RecruitmentProgramDTO program)
    {
        editingProgramId = program.Id;
        currentProgram.Name = program.Name;
        currentProgram.OpenDate = program.OpenDate;
        currentProgram.CloseDate = program.CloseDate;

        isEditMode = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        currentProgram = new CreateRecruitmentProgramDTO();
        editingProgramId = 0;
        isEditMode = false;
        errorMessage = string.Empty;
    }

    private async Task DeleteProgram(int programId)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this recruitment program?");

        if (!confirmed)
            return;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var response = await Http.DeleteAsync($"api/RecruitmentProgram/{programId}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Recruitment program deleted successfully!";
                await LoadPrograms();

                await Task.Delay(3000);
                successMessage = string.Empty;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to delete recruitment program: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch()
    {
        try
        {
            isSearching = true;
            hasSearched = true;
            errorMessage = string.Empty;
            currentPage = 1;

            var queryParams = new List<string>();

            if (!string.IsNullOrWhiteSpace(searchFilter.Name))
                queryParams.Add($"name={Uri.EscapeDataString(searchFilter.Name)}");

            if (!string.IsNullOrWhiteSpace(searchFilter.Email))
                queryParams.Add($"email={Uri.EscapeDataString(searchFilter.Email)}");

            if (!string.IsNullOrWhiteSpace(searchFilter.University))
                queryParams.Add($"university={Uri.EscapeDataString(searchFilter.University)}");

            if (!string.IsNullOrWhiteSpace(searchFilter.Major))
                queryParams.Add($"major={Uri.EscapeDataString(searchFilter.Major)}");

            if (searchFilter.FromDate.HasValue)
                queryParams.Add($"fromDate={searchFilter.FromDate.Value:yyyy-MM-dd}");

            if (searchFilter.ToDate.HasValue)
                queryParams.Add($"toDate={searchFilter.ToDate.Value:yyyy-MM-dd}");

            if (!string.IsNullOrWhiteSpace(searchFilter.Office))
                queryParams.Add($"office={Uri.EscapeDataString(searchFilter.Office)}");

            if (!string.IsNullOrWhiteSpace(searchFilter.Status))
                queryParams.Add($"status={Uri.EscapeDataString(searchFilter.Status)}");

            if (!string.IsNullOrWhiteSpace(searchFilter.Gender))
                queryParams.Add($"gender={Uri.EscapeDataString(searchFilter.Gender)}");

            if (!string.IsNullOrWhiteSpace(searchFilter.FirstPreference))
                queryParams.Add($"firstPreference={Uri.EscapeDataString(searchFilter.FirstPreference)}");

            if (!string.IsNullOrWhiteSpace(searchFilter.SecondPreference))
                queryParams.Add($"secondPreference={Uri.EscapeDataString(searchFilter.SecondPreference)}");

            if (searchFilter.ProgramId.HasValue && searchFilter.ProgramId > 0)
                queryParams.Add($"programId={searchFilter.ProgramId}");

            queryParams.Add($"page={currentPage}");
            queryParams.Add($"pageSize={pageSize}");

            var queryString = string.Join("&", queryParams);

            var response = await Http.GetAsync($"api/CandidateSearch/search?{queryString}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CandidateSearchResponse>();
                candidates = result?.Candidates ?? new();
                totalCandidates = result?.TotalCount ?? 0;
                totalPages = (int)Math.Ceiling((double)totalCandidates / pageSize);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to search candidates: {response.StatusCode} - {errorContent}";
                candidates = new();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            candidates = new();
        }
        finally
        {
            isSearching = false;
        }
    }
    private async Task DeactivateCandidate(int userId)
    {
