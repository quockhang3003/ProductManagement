@page "/admin/system-configuration"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Domain.DTO
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory ClientFactory

<PageTitle>System Configuration Management</PageTitle>

<div class="container-fluid mt-4">
    <h2 class="kpmg-header">
        <div class="kpmg-title">System Configuration Management</div>
    </h2>

    <p class="step-info">
        Manage system lookup values: Office Locations, Cities, Degrees, Majors, Universities, Skills, Qualifications, etc.
    </p>

    <div class="form-container cts-width mb-4">
        <div class="education-section">
            @(isEditMode ? "Edit Configuration" : "Add New Configuration")
        </div>
        <div class="form-content px-3 py-3">
            <EditForm Model="@currentConfig" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />

                <!-- Type -->
                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Type <span class="required-asterisk">*</span></label>
                    </div>
                    <div class="col-md-9">
                        @if (isEditMode)
                        {
                            <input type="text" value="@currentConfig.Type" class="form-control cts-width-100 custom-input" disabled />
                        }
                        else
                        {
                            <InputSelect @bind-Value="currentConfig.Type" class="form-control-sm cts-width-100 custom-input">
                                <option value="">-- Select Type --</option>
                                <optgroup label="Core Settings">
                                    <option value="Office">Office Location</option>
                                    <option value="FirstPreference">First Preference</option>
                                    <option value="SecondPreference">Second Preference</option>
                                    <option value="Gender">Gender</option>
                                    <option value="Nationality">Nationality</option>
                                    <option value="Status">Application Status</option>
                                </optgroup>
                                <optgroup label="Education">
                                    <option value="City">City</option>
                                    <option value="Degree">Degree</option>
                                    <option value="Major">Major</option>
                                    <option value="University">University</option>
                                </optgroup>
                                <optgroup label="Employment & Skills">
                                    <option value="EmploymentType">Employment Type</option>
                                    <option value="SkillLevel">Skill Level</option>
                                </optgroup>
                                <optgroup label="Qualifications">
                                    <option value="Qualification">Qualification</option>
                                    <option value="QualificationStatus">Qualification Status</option>
                                </optgroup>
                            </InputSelect>
                            <ValidationMessage For="@(() => currentConfig.Type)" />
                        }
                    </div>
                </div>

                <!-- Code -->
                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Code <span class="required-asterisk">*</span></label>
                    </div>
                    <div class="col-md-9">
                        @if (isEditMode)
                        {
                            <input type="text" value="@editingCode" class="form-control custom-input" disabled />
                        }
                        else
                        {
                            <InputText @bind-Value="currentConfig.Code" class="form-control custom-input" placeholder="e.g., HCM, BA, Accounting" />
                            <small class="form-text text-muted">Use short, unique code (e.g., HCM, BA, MBA, Accounting)</small>
                            <ValidationMessage For="@(() => currentConfig.Code)" />
                        }
                    </div>
                </div>

                <!-- Display Name -->
                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Display Name <span class="required-asterisk">*</span></label>
                    </div>
                    <div class="col-md-9">
                        <InputText @bind-Value="currentConfig.DisplayName" class="form-control custom-input" placeholder="e.g., Ho Chi Minh City, Bachelor of Arts" />
                        <ValidationMessage For="@(() => currentConfig.DisplayName)" />
                    </div>
                </div>

                <!-- Display Order & Is Active -->
                <div class="d-flex justify-content-evenly mb-2 align-items-center">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Display Order</label>
                    </div>
                    <div class="col-md-3">
                        <InputNumber @bind-Value="currentConfig.DisplayOrder" class="form-control custom-input" />
                    </div>

                    <div class="col-md-3 text-end">
                        <label class="form-label">Is Active</label>
                    </div>
                    <div class="col-md-3">
                        <InputCheckbox @bind-Value="currentConfig.IsActive" class="form-check-input" />
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-evenly mb-1">
                    <div class="col-md-3"></div>
                    <div class="col-md-9 mt-1">
                        <button type="submit" class="add-btn custom-btn1 me-2" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(isEditMode ? "Update" : "Add")
                        </button>
                        @if (isEditMode)
                        {
                            <button type="button" class="custom-btn1" @onclick="CancelEdit" disabled="@isLoading">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="mb-3">
        <label class="me-2"><strong>Filter by Type:</strong></label>
        <select @bind="selectedType" class="form-select-sm">
            <option value="">-- All Types --</option>
            <optgroup label="Core Settings">
                <option value="Office">Office Location</option>
                <option value="FirstPreference">First Preference</option>
                <option value="SecondPreference">Second Preference</option>
                <option value="Gender">Gender</option>
                <option value="Nationality">Nationality</option>
                <option value="Status">Application Status</option>
            </optgroup>
            <optgroup label="Education">
                <option value="City">City</option>
                <option value="Degree">Degree</option>
                <option value="Major">Major</option>
                <option value="University">University</option>
            </optgroup>
            <optgroup label="Employment & Skills">
                <option value="EmploymentType">Employment Type</option>
                <option value="SkillLevel">Skill Level</option>
            </optgroup>
            <optgroup label="Qualifications">
                <option value="Qualification">Qualification</option>
                <option value="QualificationStatus">Qualification Status</option>
            </optgroup>
        </select>

        @if (!string.IsNullOrEmpty(selectedType))
        {
            <span class="ms-2 badge bg-info">@FilteredConfigurations.Count() items</span>
        }
    </div>

    <div class="universities-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th style="width: 12%">Type</th>
                    <th style="width: 15%">Code</th>
                    <th style="width: 30%">Display Name</th>
                    <th style="width: 10%" class="text-center">Order</th>
                    <th style="width: 10%" class="text-center">Status</th>
                    <th style="width: 13%">Updated</th>
                    <th style="width: 5%" class="text-center">Edit</th>
                    <th style="width: 5%" class="text-center">Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoadingTable)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Loading configurations...
                        </td>
                    </tr>
                }
                else if (FilteredConfigurations == null || !FilteredConfigurations.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            @if (string.IsNullOrEmpty(selectedType))
                            {
                                <span>No configurations found</span>
                            }
                            else
                            {
                                <span>No configurations found for type: <strong>@selectedType</strong></span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var config in FilteredConfigurations.OrderBy(c => c.Type).ThenBy(c => c.DisplayOrder).ThenBy(c => c.DisplayName))
                    {
                        <tr>
                            <td><span class="badge @GetTypeBadgeClass(config.Type)">@config.Type</span></td>
                            <td><code>@config.Code</code></td>
                            <td>@config.DisplayName</td>
                            <td class="text-center">@config.DisplayOrder</td>
                            <td class="text-center">
                                @if (config.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td><small>@config.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</small></td>
                            <td class="text-center">
                                <button class="btn btn-link p-0" @onclick="() => EditConfig(config)" disabled="@isLoading" title="Edit">
                                    <img src="/images/icons8-edit-property-30.png" class="cst-icon-action" alt="Edit" />
                                </button>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-link p-0" @onclick="() => DeleteConfig(config.Id)" disabled="@isLoading" title="Delete">
                                    <span style="font-size: 20px; color: #dc3545;">✖</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <strong>✓</strong> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <strong>✗</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }
</div>

@code {
    private List<SystemConfigurationDTO> configurations = new();
    private CreateSystemConfigurationDTO currentConfig = new() { IsActive = true };
    private int editingId = 0;
    private string editingCode = string.Empty;
    private bool isEditMode = false;
    private bool isLoading = false;
    private bool isLoadingTable = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string selectedType = string.Empty;

    private HttpClient Http => ClientFactory.CreateClient("LocalAPI");

    private IEnumerable<SystemConfigurationDTO> FilteredConfigurations =>
        string.IsNullOrEmpty(selectedType)
            ? configurations
            : configurations.Where(c => c.Type == selectedType);

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigurations();
    }

    private async Task LoadConfigurations()
    {
        try
        {
            isLoadingTable = true;
            errorMessage = string.Empty;

            var response = await Http.GetAsync("api/SystemConfiguration/grouped");

            if (response.IsSuccessStatusCode)
            {
                var grouped = await response.Content.ReadFromJsonAsync<List<SystemConfigurationGroupDTO>>();

                configurations = grouped?
                    .SelectMany(g => g.Items)
                    .ToList() ?? new();
            }
            else
            {
                errorMessage = "Failed to load configurations from server";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoadingTable = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (isEditMode)
        {
            await UpdateConfig();
        }
        else
        {
            await AddConfig();
        }
    }

    private async Task AddConfig()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var response = await Http.PostAsJsonAsync("api/SystemConfiguration", currentConfig);

            if (response.IsSuccessStatusCode)
            {
                successMessage = $"Configuration '{currentConfig.DisplayName}' added successfully!";
                await LoadConfigurations();
                ResetForm();

                await Task.Delay(3000);
                successMessage = string.Empty;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to add configuration: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateConfig()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var updateDTO = new UpdateSystemConfigurationDTO
            {
                Id = editingId,
                DisplayName = currentConfig.DisplayName,
                DisplayOrder = currentConfig.DisplayOrder,
                IsActive = currentConfig.IsActive
            };

            var response = await Http.PutAsJsonAsync("api/SystemConfiguration", updateDTO);

            if (response.IsSuccessStatusCode)
            {
                successMessage = $"Configuration '{currentConfig.DisplayName}' updated successfully!";
                await LoadConfigurations();
                ResetForm();

                await Task.Delay(3000);
                successMessage = string.Empty;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to update: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditConfig(SystemConfigurationDTO config)
    {
        editingId = config.Id;
        editingCode = config.Code;
        currentConfig.Type = config.Type;
        currentConfig.Code = config.Code;
        currentConfig.DisplayName = config.DisplayName;
        currentConfig.DisplayOrder = config.DisplayOrder;
        currentConfig.IsActive = config.IsActive;

        isEditMode = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        currentConfig = new CreateSystemConfigurationDTO { IsActive = true };
        editingId = 0;
        editingCode = string.Empty;
        isEditMode = false;
        errorMessage = string.Empty;
    }

    private async Task DeleteConfig(int id)
    {
        var config = configurations.FirstOrDefault(c => c.Id == id);
        var confirmMessage = config != null
            ? $"Are you sure you want to delete '{config.DisplayName}' ({config.Type})?\n\nThis may affect existing data that references this configuration."
            : "Are you sure you want to delete this configuration?";

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage);

        if (!confirmed)
            return;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var response = await Http.DeleteAsync($"api/SystemConfiguration/{id}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Configuration deleted successfully!";
                await LoadConfigurations();

                await Task.Delay(3000);
                successMessage = string.Empty;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to delete: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetTypeBadgeClass(string type)
    {
        var normalized = type?.Trim().ToLowerInvariant() ?? string.Empty;
        return normalized switch
        {
            "office" => "badge-office",
            "city" => "badge-city",
            "firstpreference" => "badge-firstpreference",
            "secondpreference" => "badge-secondpreference",
            "degree" => "badge-degree",
            "major" => "badge-major",
            "university" => "badge-university",
            "gender" => "badge-gender",
            "nationality" => "badge-nationality",
            "employmenttype" => "badge-employmenttype",
            "skilllevel" => "badge-skilllevel",
            "qualification" => "badge-qualification",
            "qualificationstatus" => "badge-qualificationstatus",
            "status" => "badge-status",
            _ => "badge-default"
        };
    }
}


