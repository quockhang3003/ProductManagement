    private HttpClient Http => ClientFactory.CreateClient("LocalAPI");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            Console.WriteLine($"Is Authenticated: {authState.User.Identity?.IsAuthenticated}");
            Console.WriteLine($"Claims: {string.Join(",", authState.User.Claims.Select(c => $"{c.Type}={c.Value}"))}");

            Console.WriteLine("OnAfterRenderAsync: firstRender -> Load session info");
            var sessionInfo = await SessionService.GetSessionInfoAsync();
            Console.WriteLine($"Session Info - IsUser: {sessionInfo.IsUser}, Email: {sessionInfo.UserEmail}, UserId: {sessionInfo.UserId}");

            await CheckAuthenticationAndLoadData();
            isCheckingAuth = false;
            StateHasChanged();
        }
    }

    private async Task CheckAuthenticationAndLoadData()
    {
        try
        {
            Console.WriteLine("=== EducationPage: Starting authentication check ===");

            await Task.Delay(100);

            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            Console.WriteLine($"EducationPage - AuthState IsAuthenticated: {user.Identity?.IsAuthenticated}");
            Console.WriteLine($"EducationPage - AuthState Name: '{user.Identity?.Name}'");
            Console.WriteLine($"EducationPage - AuthState AuthenticationType: '{user.Identity?.AuthenticationType}'");
            Console.WriteLine($"EducationPage - User.IsInRole('User'): {user.IsInRole("User")}");
            Console.WriteLine($"EducationPage - All Claims: {string.Join(", ", user.Claims.Select(c => $"{c.Type}:{c.Value}"))}");

            isAuthenticated = user.Identity?.IsAuthenticated == true && user.IsInRole("User");
            Console.WriteLine($"EducationPage - Final isAuthenticated: {isAuthenticated}");

            if (isAuthenticated)
            {
                currentUserEmail = user.Identity.Name ?? "";

                var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (int.TryParse(userIdClaim, out int userId))
                {
                    currentUserId = userId;
                    Console.WriteLine($"EducationPage - User ID from claims: {currentUserId}");
                    await LoadInitialData();
                }
                else
                {
                    Console.WriteLine("EducationPage - Failed to get user ID from claims");

                    var sessionInfo = await SessionService.GetSessionInfoAsync();         
                    if (sessionInfo.IsUser && sessionInfo.UserId.HasValue)
                    {
                        currentUserId = sessionInfo.UserId.Value; 
                        currentUserEmail = sessionInfo.UserEmail;
                        Console.WriteLine($"EducationPage - User ID from session: {currentUserId}");
                        await LoadInitialData();
                    }
                    else
                    {
                        errorMessage = "Unable to retrieve user ID. Please login again.";
                        showErrorMessage = true;
                        isAuthenticated = false;                 
                    }                                       
                }
            }
            else
            {
                Console.WriteLine("EducationPage - User not authenticated or not in User role");

                var sessionInfo = await SessionService.GetSessionInfoAsync();
                Console.WriteLine($"SessionService fallback check - IsUser: {sessionInfo.IsUser}, Email: '{sessionInfo.UserEmail}', UserId: {sessionInfo.UserId}");

                if (sessionInfo.IsUser)
                {
                    Console.WriteLine("SessionService shows user is logged in, but AuthProvider doesn't. Forcing auth refresh...");
                    if (AuthProvider is CustomAuthStateProvider customProvider)
                    {
                        await customProvider.RefreshStateAsync();
                        await Task.Delay(100);
                        authState = await AuthProvider.GetAuthenticationStateAsync();
                        user = authState.User;
                        isAuthenticated = user.Identity?.IsAuthenticated == true && user.IsInRole("User");

                        Console.WriteLine($"After forced refresh - isAuthenticated: {isAuthenticated}");

                        if (isAuthenticated && sessionInfo.UserId.HasValue)
                        {
                            currentUserId = sessionInfo.UserId.Value;
                            currentUserEmail = sessionInfo.UserEmail;
                            await LoadInitialData();
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in CheckAuthenticationAndLoadData: {ex}");
            errorMessage = $"Authentication error: {ex.Message}";
            showErrorMessage = true;
            isAuthenticated = false;
        }
        finally
        {
            isLoading = false;
            Console.WriteLine($"=== EducationPage: Final state - isAuthenticated: {isAuthenticated}, currentUserId: {currentUserId} ===");
            StateHasChanged();
        }
    }

    private async Task LoadInitialData()
    {
        try
        {
            var universityTask = Http.GetFromJsonAsync<List<SystemConfigurationDTO>>("api/SystemConfiguration/type/University/active");
            var majorTask = Http.GetFromJsonAsync<List<SystemConfigurationDTO>>("api/SystemConfiguration/type/Major/active");
            var degreeTask = Http.GetFromJsonAsync<List<SystemConfigurationDTO>>("api/SystemConfiguration/type/Degree/active");
            var qualificationTask = Http.GetFromJsonAsync<List<SystemConfigurationDTO>>("api/SystemConfiguration/type/Qualification/active");
            var qualificationStatusTask = Http.GetFromJsonAsync<List<SystemConfigurationDTO>>("api/SystemConfiguration/type/QualificationStatus/active");
            var levelSkillTask = Http.GetFromJsonAsync<List<SystemConfigurationDTO>>("api/SystemConfiguration/type/SkillLevel/active");

            await Task.WhenAll(universityTask, majorTask, degreeTask, qualificationTask, qualificationStatusTask, levelSkillTask);

            universities = universityTask.Result ?? new List<SystemConfigurationDTO>();
            majors = majorTask.Result ?? new List<SystemConfigurationDTO>();
            degrees = degreeTask.Result ?? new List<SystemConfigurationDTO>();
            qualifications = qualificationTask.Result ?? new List<SystemConfigurationDTO>();
            qualificationStatuses = qualificationStatusTask.Result ?? new List<SystemConfigurationDTO>();
            skillLevels = levelSkillTask.Result ?? new List<SystemConfigurationDTO>();
                                     
            await LoadEducations();
            await LoadProfessionalQualification();
            await LoadLanguageAbilities();
            await LoadLanguageProficiency();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load data: {ex.Message}";
            showErrorMessage = true;
        }
    }  

    private async Task LoadEducations()
