    private List<SystemConfigurationDTO> qualificationStatuses = new List<SystemConfigurationDTO>();
    private List<SystemConfigurationDTO> skillLevels = new List<SystemConfigurationDTO>();
    private bool isCheckingAuth = true;
    private bool showSuccessMessage = false;
    private bool showErrorMessage = false;
    private string successMessage = "";
    private string errorMessage = "";
    private bool isSubmitting = false;
    private bool isLoading = true;
    private bool isDeleting = false;
