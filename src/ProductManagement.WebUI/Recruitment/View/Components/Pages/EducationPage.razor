    private async Task HandleAdd<TModel>(
        string apiEndpoint,
        TModel model,
        Func<Task> reloadFunc,
        string successMsg,
        string errorPrefix)
    {
        if (isSubmitting || !isAuthenticated) return;

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync(apiEndpoint, model);

            if (response.IsSuccessStatusCode)
            {
                successMessage = successMsg;
                showSuccessMessage = true;
                showErrorMessage = false;

                await reloadFunc(); // Load lại dữ liệu

                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    showSuccessMessage = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Session expired. Please login again.";
                showErrorMessage = true;
                await Task.Delay(2000);
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"{errorPrefix}: {errorContent}";
                showErrorMessage = true;
                showSuccessMessage = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{errorPrefix}: {ex.Message}";
            showErrorMessage = true;
            showSuccessMessage = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
    private async Task HandleDelete<T>(
        string apiEndpoint,
        int id,
        List<T> targetList,
        string successMsg,
        string errorPrefix)
        where T : class
    {
        if (isDeleting || !isAuthenticated) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this record?");
        if (!confirmed) return;

        isDeleting = true;
        deletingId = id;

        try
        {
            var response = await Http.DeleteAsync($"{apiEndpoint}/{id}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = successMsg;
                showSuccessMessage = true;
                showErrorMessage = false;

                targetList.RemoveAll(e =>
                {
                    var prop = e.GetType().GetProperty("Id");
                    if (prop == null) return false;
                    int val = (int)(prop.GetValue(e) ?? 0);
                    return val == id;
                });

                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    showSuccessMessage = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Session expired. Please login again.";
                showErrorMessage = true;
                await Task.Delay(2000);
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"{errorPrefix}: {errorContent}";
                showErrorMessage = true;
                showSuccessMessage = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{errorPrefix}: {ex.Message}";
            showErrorMessage = true;
            showSuccessMessage = false;
        }
        finally
        {
            isDeleting = false;
            deletingId = 0;
            StateHasChanged();
        }
    }

