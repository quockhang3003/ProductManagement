    private async Task UploadTranscript()
    {
        if (selectedTranscriptFile == null || selectedUniversityIdForTranscript == 0)
            return;

        try
        {
            isUploadingTranscript = true;
            transcriptErrorMessage = string.Empty;
            StateHasChanged();

            var selectedUni = userUniversities.FirstOrDefault(u => u.Id == selectedUniversityIdForTranscript);
            if (selectedUni == null)
            {
                transcriptErrorMessage = "Selected university not found";
                return;
            }

            Console.WriteLine($"[Upload] Selected University:");
            Console.WriteLine($"  - Id: {selectedUni.Id}");
            Console.WriteLine($"  - Code: {selectedUni.Code}");
            Console.WriteLine($"  - DisplayName: {selectedUni.DisplayName}");

            using var content = new MultipartFormDataContent();

            var fileContent = new StreamContent(
                selectedTranscriptFile.OpenReadStream(maxTranscriptFileSize));
            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(selectedTranscriptFile.ContentType);

            content.Add(fileContent, "TranscriptFile", selectedTranscriptFile.Name);
            content.Add(new StringContent(userEmail), "UserEmail");

            content.Add(new StringContent(selectedUni.Code), "UniversityCode");

            var response = await Http.PostAsync("/api/Transcript/upload", content);

            if (response.IsSuccessStatusCode)
            {
                var jsonResponse = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<TranscriptUploadResponse>(
                    jsonResponse,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result?.Success == true)
                {
                    transcriptSuccessMessage = result.Message;
                    selectedTranscriptFile = null;
                    selectedUniversityIdForTranscript = 0;
                    await LoadTranscripts();
                    StateHasChanged();
                }
                else
                {
                    transcriptErrorMessage = result?.Message ?? "Upload failed";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                transcriptErrorMessage = $"Upload failed: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            transcriptErrorMessage = $"Upload failed: {ex.Message}";
            Console.WriteLine($"Exception during transcript upload: {ex}");
        }
        finally
        {
            isUploadingTranscript = false;
            StateHasChanged();
        }
    }

