    private async Task SubmitApplication()
    {
        try
        {
            heardAboutValidationMessage = string.Empty;
            errorMessage = string.Empty;


            if (!heardAbout.HasAnySelection())
            {
                heardAboutValidationMessage = "Please select at least one option for how you heard about KPMG.";
                StateHasChanged();
                return;
            }
            if (!agreeToTerms)
            {
                heardAboutValidationMessage = "Please agree to the terms and conditions before submitting.";
                StateHasChanged();
                return;
            }
            var saveRequest = new
            {
                UserEmail = userEmail,
                KpmgWebsite = heardAbout.KpmgWebsite,
                UniversityClubs = heardAbout.UniversityClubs,
                Others = heardAbout.Others,
                FacebookGroup = heardAbout.FacebookGroup,
                UniversityWebsite = heardAbout.UniversityWebsite,
                KpmgPresentation = heardAbout.KpmgPresentation,
                KpmgSocialMedia = heardAbout.KpmgSocialMedia,
                Tiktok = heardAbout.Tiktok,
                CareerTalk = heardAbout.CareerTalk,
                Professor = heardAbout.Professor,
                CampusAmbassadors = heardAbout.CampusAmbassadors,
                AgreeToTerms = agreeToTerms
            };


            var saveResponse = await Http.PostAsJsonAsync("/api/HeardAbout/save", saveRequest);

            if (!saveResponse.IsSuccessStatusCode)
            {
                var errorContent = await saveResponse.Content.ReadAsStringAsync();
                heardAboutValidationMessage = $"Failed to save data: {errorContent}";
                Console.WriteLine($"Submit error - save failed: {errorContent}");
                StateHasChanged();
                return;
            }
            var saveResult = await saveResponse.Content.ReadFromJsonAsync<HeardAboutSaveResponse>();
            if (saveResult?.Success != true)
            {
                heardAboutValidationMessage = $"Failed to save data: {saveResult?.Message}";
                StateHasChanged();
                return;
            }
            Console.WriteLine("Application submitted successfully!");
            Navigation.NavigateTo("/review");
        }
        catch (Exception ex)
        {
            heardAboutValidationMessage = $"Submit failed: {ex.Message}";
            Console.WriteLine($"Exception during submit: {ex}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            StateHasChanged();
        }
    }

