    private async Task LoadPersonalPerspectiveData()
    {
        try
        {
            if (userId.HasValue && userId.Value > 0)
            {
                Console.WriteLine($"[LoadPersonalPerspectiveData] Admin mode detected - requesting admin endpoint for user {userId.Value}");
                var adminQwa = await GetJsonSafe<List<QuestionWithAnswerDTO>>($"api/UserQuestionAnswer/user/{userId.Value}/questions-with-answers");
                if (adminQwa != null && adminQwa.Any())
                {
                    Console.WriteLine($"[LoadPersonalPerspectiveData] Admin endpoint returned {adminQwa.Count} Q+A items");
                    userQuestionAnswers = adminQwa.Select(x => new UserQuestionAnswerWithQuestionDTO
                    {
                        QuestionId = x.Id,
                        QuestionText = x.Text,
                        Answer = x.Answer,
                        CreatedAt = x.AnswerUpdatedAt ?? DateTime.MinValue,
                        UpdatedAt = x.AnswerUpdatedAt ?? DateTime.MinValue,
                        UserId = userId.Value
                    }).ToList();
                    return;
                }
                else
                {
                    Console.WriteLine("[LoadPersonalPerspectiveData] Admin endpoint returned null/empty - will fallback to other endpoints");
                }
            }

            var qwa = await TryMultipleEndpoints<List<QuestionWithAnswerDTO>>(
                "api/UserQuestionAnswer/questions-with-answers", 
                $"api/UserQuestionAnswer/user/{currentUserId}",  
                $"api/UserQuestionAnswer/user/{Uri.EscapeDataString(currentUserEmail)}"
            );

            if (qwa != null && qwa.Any())
            {
                Console.WriteLine($"[LoadPersonalPerspectiveData] questions-with-answers count = {qwa.Count}");
                userQuestionAnswers = qwa.Select(x => new UserQuestionAnswerWithQuestionDTO
                {
                    QuestionId = x.Id,
                    QuestionText = x.Text,
                    Answer = x.Answer,
                    CreatedAt = x.AnswerUpdatedAt ?? DateTime.MinValue,
                    UpdatedAt = x.AnswerUpdatedAt ?? DateTime.MinValue,
                    UserId = currentUserId
                }).ToList();
                return;
            }
            var questions = await TryMultipleEndpoints<List<QuestionDTO>>("api/Question", "api/UserQuestion", "api/Questions") ?? new List<QuestionDTO>();
            var answers = await TryMultipleEndpoints<List<UserQuestionAnswerWithQuestionDTO>>("api/UserQuestionAnswer/questions-with-answers", $"api/UserQuestionAnswer/user/{currentUserId}") ?? new List<UserQuestionAnswerWithQuestionDTO>();

            Console.WriteLine($"[LoadPersonalPerspectiveData] Master questions count = {questions.Count}");
            Console.WriteLine($"[LoadPersonalPerspectiveData] User answers count = {answers.Count}");

            var answersById = answers.Where(a => a.QuestionId > 0).GroupBy(a => a.QuestionId)
                                     .ToDictionary(g => g.Key, g => g.OrderBy(a => a.UpdatedAt).Last().Answer ?? "", EqualityComparer<int>.Default);

            var answersByText = answers.Where(a => a.QuestionId <= 0 && !string.IsNullOrWhiteSpace(a.QuestionText))
                                      .GroupBy(a => a.QuestionText!.Trim(), StringComparer.OrdinalIgnoreCase)
                                      .ToDictionary(g => g.Key, g => g.OrderBy(a => a.UpdatedAt).Last().Answer ?? "", StringComparer.OrdinalIgnoreCase);

            var combined = new List<UserQuestionAnswerWithQuestionDTO>();

            foreach (var q in questions)
            {
                string ans = "";
                if (q.Id > 0 && answersById.TryGetValue(q.Id, out var aById))
                {
                    ans = aById;
                }
                else
                {
                    var key = (q.Text ?? "").Trim();
                    if (!string.IsNullOrEmpty(key) && answersByText.TryGetValue(key, out var aByText))
                    {
                        ans = aByText;
                    }
                }

                combined.Add(new UserQuestionAnswerWithQuestionDTO
                {
                    QuestionId = q.Id,
                    QuestionText = q.Text ?? $"Question {q.Id}",
                    Answer = ans ?? "",
                    CreatedAt = DateTime.MinValue,
                    UpdatedAt = DateTime.MinValue,
                    UserId = currentUserId
                });
            }

            if (!combined.Any() && answers.Any())
            {
                combined = answers.Select(a => new UserQuestionAnswerWithQuestionDTO
                {
                    QuestionId = a.QuestionId,
                    QuestionText = a.QuestionText,
                    Answer = a.Answer,
                    CreatedAt = a.CreatedAt,
                    UpdatedAt = a.UpdatedAt,
                    UserId = a.UserId
                }).ToList();
            }

            userQuestionAnswers = combined;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadPersonalPerspectiveData] Exception: {ex}");
        }
        finally
        {
            try
            {
                await LoadHowHeardData();
            }
            catch (Exception hx)
            {
                Console.WriteLine($"[LoadPersonalPerspectiveData] LoadHowHeardData failed: {hx}");
            }
        }
    }

    private async Task LoadHowHeardData()
    {
        try
        {
            
            if (string.IsNullOrEmpty(currentUserEmail))
            {
                Console.WriteLine("[LoadHowHeardData] No currentUserEmail, skip fetching user heard-about data.");
                return;
            }
            var endpoint = $"api/HeardAbout/user/{Uri.EscapeDataString(currentUserEmail)}";
            var resp = await Http.GetAsync(endpoint);

            if (!resp.IsSuccessStatusCode)
            {
                Console.WriteLine($"[LoadHowHeardData] Endpoint returned {(int)resp.StatusCode}");
                return;
            }

            var content = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(content))
            {
                Console.WriteLine("[LoadHowHeardData] Empty response body");
                return;
            }

            using var doc = System.Text.Json.JsonDocument.Parse(content);
            var root = doc.RootElement;

            if (root.ValueKind == JsonValueKind.Object)
            {
                var knownMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                { "kpmgWebsite", "KPMG Website" },
                { "universityClubs", "University Clubs" },
                { "others", "Others" },
                { "facebookGroup", "Facebook Group" },
                { "universityWebsite", "University Website" },
                { "kpmgPresentation", "KPMG Presentation" },
                { "kpmgSocialMedia", "KPMG Social Media" },
                { "tiktok", "TikTok" },
                { "careerTalk", "Career Talk" },
                { "professor", "Professor" },
                { "campusAmbassadors", "Campus Ambassadors" }
            };

                var opts = new List<HowHeardOptionDTO>();
                var sel = new List<string>();
                int idx = 1;

                foreach (var kv in knownMap)
                {
                    var key = kv.Key;
                    var label = kv.Value;
                    bool value = false;
                    if (root.TryGetProperty(key, out var prop) && prop.ValueKind == JsonValueKind.True)
                    {
                        value = true;
                    }

                    opts.Add(new HowHeardOptionDTO { Id = idx++, OptionText = label });
                    if (value) sel.Add(label);
                }

                howHeardOptions = opts;
                userSelectedHowHeard = sel;

                if (root.TryGetProperty("agreeToTerms", out var agreeProp) && agreeProp.ValueKind == JsonValueKind.True)
                {
                    agreeToTermsSelected = true;
                }
                else
                {
                    agreeToTermsSelected = false;
                }
            }
            else
            {
            }
            if ((howHeardOptions == null || !howHeardOptions.Any()) && userSelectedHowHeard?.Any() == true)
            {
                howHeardOptions = userSelectedHowHeard
                    .Select((s, i) => new HowHeardOptionDTO { Id = i + 1, OptionText = s })
                    .ToList();
            }

            Console.WriteLine($"[LoadHowHeardData] User selected how-heard count = {userSelectedHowHeard?.Count ?? 0}, agree={agreeToTermsSelected}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadHowHeardData] Exception: {ex}");
        }
    }

    private async Task LoadPhotoAndAttachments()
    {
        try
        {
            if (currentUserId > 0)
            {
                Console.WriteLine($"[LoadPhotoAndAttachments] Loading transcripts/attachments by userId {currentUserId}");
                transcripts = await GetJsonSafe<List<TranscriptDTO>>($"api/Transcript/userid/{currentUserId}") ?? new();
                attachments = await GetJsonSafe<List<AttachmentsDTO>>($"api/Attachments/userid/{currentUserId}") ?? new();

                var photoById = await GetJsonSafe<PhotoResponse>($"api/Photo/userid/{currentUserId}");
                if (photoById != null && !string.IsNullOrEmpty(photoById.ImageSrc))
                {
                    userPhotoBase64 = photoById.ImageSrc;
                }
            }

            if ((transcripts == null || !transcripts.Any()) && !string.IsNullOrEmpty(currentUserEmail))
            {
                Console.WriteLine("[LoadPhotoAndAttachments] Fallback load by email");
                var photoResponse = await GetJsonSafe<PhotoResponse>($"api/Photo/base64/{Uri.EscapeDataString(currentUserEmail)}");
                if (photoResponse != null && !string.IsNullOrEmpty(photoResponse.ImageSrc))
                {
                    userPhotoBase64 = photoResponse.ImageSrc;
                }

                transcripts = await GetJsonSafe<List<TranscriptDTO>>($"api/Transcript/user/{Uri.EscapeDataString(currentUserEmail)}") ?? transcripts ?? new();
                attachments = await GetJsonSafe<List<AttachmentsDTO>>($"api/Attachments/user/{Uri.EscapeDataString(currentUserEmail)}") ?? attachments ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadPhotoAndAttachments] Exception: {ex}");
        }
    }

