        Console.WriteLine($"[LoadUserData] Attempting to load user for id={currentUserId}");

        // danh sách endpoint thử (thêm các biến thể phổ biến)
        var endpoints = new[]
        {
        $"api/User/{currentUserId}",
        $"api/Users/{currentUserId}",
        $"api/User/by-id/{currentUserId}",
        $"api/Application/user/{currentUserId}",
        $"api/User/profile/{currentUserId}",
