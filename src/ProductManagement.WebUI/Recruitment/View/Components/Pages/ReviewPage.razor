    private string GetDecryptedIDCard()
    {
        try
        {
            if (userInfo == null)
                return "N/A";

            if (!string.IsNullOrEmpty(userInfo.IDCardNoEncrypted))
            {
                var decrypted = EncryptionService.Decrypt(userInfo.IDCardNoEncrypted);

                Console.WriteLine($"[AUDIT] IDCard decrypted for User {userInfo.Id} in Review page at {DateTime.UtcNow}");

                return decrypted ?? "N/A";
            }

            if (!string.IsNullOrEmpty(userInfo.PasswordHash) &&
                !userInfo.PasswordHash.StartsWith("$2")) 
            {
                Console.WriteLine($"[FALLBACK] Using PasswordHash as plaintext for User {userInfo.Id}");
                return userInfo.PasswordHash;
            }

            return "N/A";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Failed to decrypt IDCard for User {userInfo?.Id}: {ex.Message}");
            return "***ERROR***";
        }
    }

