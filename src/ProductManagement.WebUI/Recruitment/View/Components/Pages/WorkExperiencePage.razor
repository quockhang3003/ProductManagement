    private async Task PreviousStep()
    {
        var answeredQuestions = Questions.Where(q => !string.IsNullOrWhiteSpace(q.Answer)).ToList();
        if (answeredQuestions.Any())
        {
            try
            {
                await SaveQuestionsAsync();
                successMessage = "Answers auto-saved successfully!";
                showSuccessMessage = true;
                StateHasChanged();
                await Task.Delay(1000);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Auto-save failed: {ex.Message}");
            }
        }

        Navigation.NavigateTo("/step2");
    }

